# Chave pública do projeto no PostHog (opcional — sem ela, PostHog não é inicializado)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Modo cookieless para quem NÃO aceitou os cookies: o PostHog conta a visita
# sem cookie e sem storage (identidade vira hash efêmero no servidor). É o que
# dá o denominador da taxa de aceite — sem isso o PostHog só enxerga quem
# aceitou e a taxa parece 100%.
#
# Ligado por padrão. Depende de `cookieless_server_hash_mode` estar ativo no
# projeto do PostHog (habilitado em 03/09/2026, projeto 577520, modo 1
# stateless). Se for desligado lá, os eventos de quem recusou passam a ser
# descartados em silêncio — só nesse caso, setar como "false".
VITE_POSTHOG_COOKIELESS_ON_REJECT=true
