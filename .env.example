# Chave pública do projeto no PostHog (opcional — sem ela, PostHog não é inicializado)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Conta quem RECUSOU os cookies sem gravar cookie nem storage (identidade vira
# um hash efêmero no servidor do PostHog). É o que permite medir a taxa real de
# aceite — sem isso, o denominador some junto com quem recusou.
# ⚠️ Só ligue depois de habilitar o modo cookieless nas configurações do projeto
# no PostHog; senão os eventos de quem recusou são descartados em silêncio.
VITE_POSTHOG_COOKIELESS_ON_REJECT=false
